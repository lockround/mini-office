{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MiniOffice",
  "version": "0.1.0",
  "identifier": "com.minioffice.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MiniOffice",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "fileAssociations": [
      {
        "name": "MiniOffice CSV",
        "ext": ["csv"],
        "description": "Comma-separated values file",
        "role": "Editor"
      },
      {
        "name": "MiniOffice XLSX",
        "ext": ["xlsx"],
        "description": "Excel workbook",
        "role": "Editor"
      },
      {
        "name": "MiniOffice DOCX",
        "ext": ["docx"],
        "description": "Word document",
        "role": "Editor"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      },
      "wix": {
        "language": "en-US"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
